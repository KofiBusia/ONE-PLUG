# Copy to .env for local runs. Never commit .env.
SECRET_KEY=change-me

# Leave blank to use instance/oneplug.db (SQLite). Render sets this from the database.
DATABASE_URL=
# Local PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/oneplug

# Google Cloud > Maps JavaScript API key, restricted to your domain(s)
GOOGLE_MAPS_API_KEY=
# Google Maps Platform > Map management > JavaScript map ID
GOOGLE_MAP_ID=

FLASK_DEBUG=1
AUTO_SEED=1
